{
    "name": "pagination",
    "type": "plugin",
    "version": "1.0.0",
    "namespace": "Wawoo\\Plugin\\Pagination",
    "entry": "Plugin",
    "requires": {
        "core": ">=1.0.0"
    },
    "hooks": {
