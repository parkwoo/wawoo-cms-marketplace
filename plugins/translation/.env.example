# Translation Plugin Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
TRANSLATION_API_KEY=your-api-key-here

# Translation Provider (openai, anthropic)
TRANSLATION_PROVIDER=openai

# Model to use for translation
TRANSLATION_MODEL=gpt-3.5-turbo

# Language Settings
TRANSLATION_SOURCE_LANGUAGE=ja
TRANSLATION_TARGET_LANGUAGE=en

# Behavior Settings
TRANSLATION_AUTO_TRANSLATE=false
TRANSLATION_VALIDATE_TRANSLATION=true
TRANSLATION_FALLBACK_TO_ORIGINAL=true

# Performance Settings
TRANSLATION_MAX_RETRIES=3
TRANSLATION_TIMEOUT=30
TRANSLATION_BATCH_SIZE=5