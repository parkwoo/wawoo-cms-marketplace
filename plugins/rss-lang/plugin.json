{
    "name": "rss-lang",
    "type": "plugin",
    "version": "1.0.0",
    "namespace": "Wawoo\\Plugin\\RssLang",
    "entry": "Plugin",
    "requires": {
        "core": ">=1.0.0",
        "mlang": ">=1.0.0"
    },
    "hooks": {
        "core.request": "Feed",
        "theme.head.after": "HeadLinks"
    },
    "config": {
        "max_items": 20,
        "langs": "auto",
        "default_lang": "ja"
    }
}
