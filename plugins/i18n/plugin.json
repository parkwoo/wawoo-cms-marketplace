{
    "name": "i18n",
    "type": "plugin",
    "version": "1.0.0",
    "namespace": "Wawoo\\Plugin\\I18n",
    "entry": "Plugin",
    "settings": true,
    "requires": { "core": ">=1.0.0" },
    "hooks": {
        "core.boot": "Init",
        "theme.nav": "Switcher"
    },
    "config": {
        "default": "en",
        "supported": ["en", "ja", "zh"],
        "cookie_name": "wawoo_lang",
        "detect_browser": true,
        "url_param": "lang"
    }
}
